<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mdp-mcp</AssemblyName>
    <Version>0.14.0</Version>

    <!-- NuGet Tool Package settings -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>markdown-pointer</ToolCommandName>
    <PackageId>MarkdownPointer.Mcp</PackageId>
    <Authors>Yoshifumi Tsuda</Authors>
    <Description>MCP server for MarkdownPointer - A Markdown viewer with Mermaid, KaTeX, and PPTX export support</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/yotsuda/MarkdownPointer</PackageProjectUrl>
    <PackageTags>mcp;markdown;viewer;mermaid;katex;pptx;slides</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Single File deployment -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Exclude debug symbols from publish -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlideKit\SlideKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
  </ItemGroup>

  <!-- Include README for NuGet -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
