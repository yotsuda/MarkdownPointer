<Window x:Class="MarkdownPointer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markdown Pointer" Height="768" Width="1024"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        AllowDrop="True"
        PreviewDrop="Window_Drop"
        PreviewDragOver="Window_DragOver"
        PreviewKeyDown="Window_KeyDown" PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <Style x:Key="SubtleLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#0366d6"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab control with drop indicator -->
        <Grid Grid.Row="0">
            <TabControl x:Name="FileTabControl"
                        SelectionChanged="TabControl_SelectionChanged"
                        Visibility="Collapsed">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                MouseLeftButtonDown="TabHeader_MouseLeftButtonDown"
                                MouseMove="TabHeader_MouseMove"
                                Tag="{Binding}">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                        <Button Content="✕"
                                Click="CloseTab_Click"
                                Tag="{Binding}"
                                Width="16" Height="16"
                                Margin="8,0,0,0"
                                FontSize="11"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                FocusVisualStyle="{x:Null}"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentPresenter Content="{Binding WebView}"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
            <!-- Drop indicator for tab reordering -->
            <Canvas x:Name="TabDropIndicatorCanvas" IsHitTestVisible="False">
                <Rectangle x:Name="TabDropIndicator" 
                           Width="3" Height="24" 
                           Fill="#0078D4" 
                           Visibility="Collapsed"/>
            </Canvas>
        </Grid>

        <!-- Placeholder when no file is loaded -->
        <Border x:Name="PlaceholderPanel" Grid.Row="0" Background="#F6F8FA" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="40,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="📝 " FontSize="32" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlaceholderTitle"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="#24292e" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Recent Folders -->
                    <StackPanel x:Name="RecentFoldersPanel" Grid.Row="1" Visibility="Collapsed" Margin="20,0,0,16">
                        <TextBlock Text="📁 RECENT FOLDERS" FontSize="10" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Emoji" Foreground="#8B949E" Margin="4,0,0,6"/>
                        <ItemsControl x:Name="RecentFoldersList" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Recent Files -->
                    <StackPanel x:Name="RecentFilesPanel" Grid.Row="2" Visibility="Collapsed" Margin="20,0,0,24">
                        <TextBlock Text="📄 RECENT FILES" FontSize="10" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Emoji" Foreground="#8B949E" Margin="4,0,0,6"/>
                        <ItemsControl x:Name="RecentFilesList" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Shortcuts (compact inline) -->
                    <TextBlock Grid.Row="3" FontSize="11" Foreground="#8B949E" FontFamily="Consolas"
                               HorizontalAlignment="Center" Margin="0,0,0,8"
                               xml:space="preserve">Ctrl+O Open   Ctrl+F Find   Ctrl+G Line   Ctrl+P Print   Ctrl+W Close   Ctrl+Tab Next</TextBlock>

                    <!-- AI integration (subtle footer) -->
                    <TextBlock Grid.Row="4" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center"
                               xml:space="preserve"><Run Text="🤖 "/><Hyperlink Style="{StaticResource SubtleLink}" NavigateUri="https://github.com/yotsuda/MarkdownPointer#readme" RequestNavigate="Hyperlink_RequestNavigate" MouseEnter="Hyperlink_MouseEnter" MouseLeave="Hyperlink_MouseLeave">MCP server</Hyperlink><Run Text=" built in — AI can open files and control slides. "/><Hyperlink Style="{StaticResource SubtleLink}" NavigateUri="https://github.com/yotsuda/PowerShell.MCP#readme" RequestNavigate="Hyperlink_RequestNavigate" MouseEnter="Hyperlink_MouseEnter" MouseLeave="Hyperlink_MouseLeave">PowerShell.MCP</Hyperlink><Run Text=" + "/><Hyperlink Style="{StaticResource SubtleLink}" NavigateUri="https://github.com/yotsuda/Speech#readme" RequestNavigate="Hyperlink_RequestNavigate" MouseEnter="Hyperlink_MouseEnter" MouseLeave="Hyperlink_MouseLeave">Speech</Hyperlink><Run Text=" for voice presentations."/></TextBlock>
                </Grid>
            </ScrollViewer>
        </Border>


        <!-- Status bar -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FilePathText"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontSize="12"
                               Foreground="#0366d6"
                               Cursor="Hand"
                               TextTrimming="CharacterEllipsis"
                               MouseEnter="FilePathText_MouseEnter"
                               MouseLeave="FilePathText_MouseLeave"
                               MouseLeftButtonUp="FilePathText_MouseLeftButtonUp"/>
                    <TextBlock x:Name="LineNumberText"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               FontSize="12"
                               Foreground="#0366d6"/>
                </StackPanel>
                <TextBlock x:Name="LinkStatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           FontSize="11"
                           Foreground="#0366d6"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock x:Name="StatusText" 
                               VerticalAlignment="Center" 
                               FontSize="11"
                               Foreground="#28A745"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="WatchStatusText" 
                               VerticalAlignment="Center" 
                               FontSize="11"
                               Foreground="#586069"
                               Margin="0,0,12,0"/>
                    
                    
                    <!-- Error indicator -->
                    <Border x:Name="ErrorIndicator" 
                            Background="#FFF3CD" 
                            BorderBrush="#FFECB5" 
                            BorderThickness="1" 
                            CornerRadius="3" 
                            Padding="6,2" 
                            Margin="0,0,12,0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            MouseLeftButtonUp="ErrorIndicator_Click">
                        <Border.ToolTip>
                            <ToolTip x:Name="ErrorToolTip" MaxWidth="500">
                                <TextBlock x:Name="ErrorToolTipText" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Border.ToolTip>
                        <TextBlock x:Name="ErrorIndicatorText" 
                                   FontSize="11" 
                                   Foreground="#856404"/>
                    </Border>
                    <!-- Action buttons -->
                    <Button x:Name="CopyPathButton"
                                  Content="Copy Path"
                                  ToolTip="Copy full file path to clipboard"
                                  Click="CopyPathButton_Click"
                                  Width="60" Height="20"
                                  FontSize="9"
                                  Background="Transparent"
                                  BorderThickness="1"/>
                    <Button x:Name="CopySourceButton"
                                  Content="Copy Source"
                                  ToolTip="Copy markdown source to clipboard"
                                  Click="CopySourceButton_Click"
                                  Width="70" Height="20"
                                  FontSize="9"
                                  Margin="4,0,0,0"
                                  Background="Transparent"
                                  BorderThickness="1"/>
                    <Button x:Name="OpenInCodeButton"
                                  Content="VS Code"
                                  ToolTip="Open in VS Code"
                                  Click="OpenInCodeButton_Click"
                                  Width="50" Height="20"
                                  FontSize="9"
                                  Margin="4,0,0,0"
                                  Background="Transparent"
                                  BorderThickness="1"/>
                    <Button x:Name="ExportButton"
                                  Content="Export"
                                  ToolTip="Export document"
                                  Click="ExportButton_Click"
                                  Width="50" Height="20"
                                  FontSize="9"
                                  Margin="4,0,0,0"
                                  Background="Transparent"
                                  BorderThickness="1"/>
                    <ToggleButton x:Name="SlideViewToggle" FontFamily="Segoe UI Emoji"
                                  Content="🎞" IsEnabled="False"
                                  ToolTip="Slide view (right-click: theme)"
                                  Click="SlideViewToggle_Click"
                                  MouseRightButtonUp="SlideViewToggle_RightClick"
                                  Width="24" Height="20"
                                  FontSize="10"
                                  Margin="4,0,0,0"
                                  Background="Transparent"
                                  BorderThickness="1"/>
                    <!-- Toggle buttons -->
                    <ToggleButton x:Name="TopmostToggle" FontFamily="Segoe UI Emoji"
                                  Content="📌"
                                  ToolTip="Always on top"
                                  Click="TopmostToggle_Click"
                                  Width="24" Height="20"
                                  FontSize="10"
                                  Margin="4,0,0,0"
                                  Background="Transparent"
                                  BorderThickness="1"/>
                    <ToggleButton x:Name="PointingModeToggle" FontFamily="Segoe UI Emoji" IsChecked="True"
                                  Content="👆"
                                  ToolTip="Pointing mode"
                                  Click="PointingModeToggle_Click"
                                  Width="24" Height="20"
                                  FontSize="10"
                                  Margin="4,0,0,0"
                                  Background="Transparent"
                                  BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
